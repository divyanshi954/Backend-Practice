<%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/hostnavbar') %>
  <main class="min-h-screen bg-gradient-to-br from-pink-50 to-red-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md mx-auto bg-white rounded-lg shadow-md p-8">
      <h2 class="text-3xl font-bold text-gray-800 mb-6"><%= editing ? "Edit Home Details" : "Register Your home here" %></h2>
      <form action="/host/<%= editing ? 'edit-home' : 'added' %>" method="post" class="space-y-4">
        <input type="hidden" name="_id" value="<%= editing ? home._id : '' %>">
        <div>
          <label for="homename" class="block text-sm font-medium text-gray-700 mb-2">Name of your house</label>
          <input type="text" id="homename" name="homename" value="<%= editing ? home.homename : '' %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent outline-none transition" required>
        </div>
        <div>
          <label for="address" class="block text-sm font-medium text-gray-700 mb-2">Address</label>
          <input type="text" id="address" name="address" value="<%= editing ? home.address : '' %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent outline-none transition" required>
        </div>
        <div>
          <label for="price" class="block text-sm font-medium text-gray-700 mb-2">Price</label>
          <input type="text" id="price" name="price" value="<%= editing ? home.price : '' %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent outline-none transition" required>
        </div>
        <button type="submit" class="w-full bg-red-500 hover:bg-red-600 text-white font-semibold py-2 px-4 rounded-lg transition duration-200"><%= editing ? "Update" : "Register Home" %></button>
      </form>
    </div>
  </main>
</body>
</html>